DISCORD_TOKEN=incolla_il_token_del_bot
# Facoltativo: pubblicazione immediata dei comandi in un server di sviluppo.
# Senza questo valore i comandi sono globali (la propagazione può richiedere tempo).
DISCORD_GUILD_ID=
# Facoltativo: porta del server HTTP/WebSocket per Discord Activity e Web Player (0 per disabilitare).
PLEXCORD_ACTIVITY_PORT=8080
# Facoltativo: URL pubblico o locale della dashboard/Activity mostrato da /activity e dai pulsanti del player.
PLEXCORD_ACTIVITY_URL=
# Facoltativo: Client Secret OAuth2 dell'app Discord per mostrare l'RPC (stato di ascolto) sul profilo degli utenti.
DISCORD_CLIENT_SECRET=
