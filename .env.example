DISCORD_TOKEN=paste_your_bot_token_here
# Optional: Immediate slash command registration in a test/development guild.
# Without this, slash commands are registered globally (which may take a few minutes to propagate).
DISCORD_GUILD_ID=
# Optional: HTTP/WebSocket port for the Discord Activity and Web Player (0 to disable, default: 8080).
PLEXCORD_ACTIVITY_PORT=8080
# Optional: Public HTTPS URL or reverse proxy endpoint for the Activity/Web Player.
PLEXCORD_ACTIVITY_URL=
# Optional: Discord OAuth2 Client Secret for personal Rich Presence ("Listening to Plex" status on member profiles).
# Can also be configured directly via the Activity UI in the "RPC & Account" tab.
DISCORD_CLIENT_SECRET=
